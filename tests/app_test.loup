@mode(host.dual)

# Exit statuses of the whole command line. These tests print the program's
# normal output and error messages.

from debug.assert import (expectEq);
from appinfo import (EXIT_OK, EXIT_FAILURE, EXIT_USAGE);
from cli.app import (run);

func test_version_and_help(): void {
    expectEq(run(["--version"]), EXIT_OK, "--version");
    expectEq(run(["--help"]), EXIT_OK, "--help");
}

func test_convert_a_fixture(): void {
    expectEq(run(["tests/fixtures/headings.md"]), EXIT_OK, "a file");
}

func test_missing_file(): void {
    expectEq(run(["/nonexistent/x.md"]), EXIT_FAILURE, "missing input");
    expectEq(run(["tests"]), EXIT_FAILURE, "a directory");
    expectEq(run(["-t", "/nonexistent/page.html", "tests/fixtures/headings.md"]), EXIT_FAILURE, "missing template");
}

func test_usage_errors(): void {
    expectEq(run(["--bogus"]), EXIT_USAGE, "unknown option");
    expectEq(run(["a.md", "b.md"]), EXIT_USAGE, "two files");
}
