@mode(host.dual)

# Unit tests for the HTML renderer (markdown.render): block layout, tight
# and loose lists, code and quotes, tables, and the first heading.
#
# Runtime: host.dual, run by the test runner: `make test` interprets this
# file with Stage0 (`loup-bootstrap test --no-parallel`, source/ on
# LOUPPATH), one test per `func test_*()`. It is not part of the binary.

from debug.assert import (expectEq);
from markdown.render import (markdown_to_html, first_heading);

func test_paragraph_and_heading(): void {
    expectEq(markdown_to_html("# Hi\n\ntext\n"), "<h1>Hi</h1>\n<p>text</p>\n", "two blocks");
    expectEq(markdown_to_html(""), "", "empty document");
}

func test_tight_and_loose_lists(): void {
    expectEq(markdown_to_html("- a\n- b\n"), "<ul>\n<li>a</li>\n<li>b</li>\n</ul>\n", "tight");
    expectEq(markdown_to_html("- a\n\n- b\n"), "<ul>\n<li>\n<p>a</p>\n</li>\n<li>\n<p>b</p>\n</li>\n</ul>\n", "loose");
    expectEq(markdown_to_html("- a\n  - b\n"), "<ul>\n<li>a\n<ul>\n<li>b</li>\n</ul>\n</li>\n</ul>\n", "nested");
    expectEq(markdown_to_html("2. x\n"), "<ol start=\"2\">\n<li>x</li>\n</ol>\n", "start");
}

func test_code_and_quote(): void {
    expectEq(markdown_to_html("```js\na<b\n```\n"), "<pre><code class=\"language-js\">a&lt;b\n</code></pre>\n", "fence");
    expectEq(markdown_to_html("> q\n"), "<blockquote>\n<p>q</p>\n</blockquote>\n", "quote");
}

func test_table(): void {
    let want = "<table>\n<thead>\n<tr>\n<th style=\"text-align:right\">a</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td style=\"text-align:right\">1</td>\n</tr>\n</tbody>\n</table>\n";
    expectEq(markdown_to_html("| a |\n|--:|\n| 1 |\n"), want, "aligned table");
    let rows = "<table>\n<thead>\n<tr>\n<th>a</th>\n<th style=\"text-align:center\">b</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>1</td>\n<td style=\"text-align:center\">2</td>\n</tr>\n<tr>\n<td>3</td>\n<td style=\"text-align:center\"></td>\n</tr>\n</tbody>\n</table>\n";
    expectEq(markdown_to_html("| a | b |\n|---|:-:|\n| 1 | 2 |\n| 3 |\n"), rows, "rows of two cells, a short row padded");
}

func test_first_heading(): void {
    expectEq(first_heading("## Sub\n# Main *title*\n# Later"), "Main title", "first level-1 heading");
    expectEq(first_heading("### Only\n"), "Only", "any level");
    expectEq(first_heading("text"), "", "none");
}
