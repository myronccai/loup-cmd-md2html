@mode(host.dual)

from debug.assert import (expect, expectEq);
from cli.args import (parse_args);

func test_defaults(): void {
    let none: list[string] = [];
    let opts = parse_args(none).unwrap();
    expectEq(opts.input, "-", "standard input");
    expectEq(opts.output, "", "standard output");
    expect(!opts.standalone and !opts.help and !opts.version, "no flags");
}

func test_file_and_output(): void {
    let opts = parse_args(["-o", "out.html", "in.md"]).unwrap();
    expectEq(opts.input, "in.md", "input");
    expectEq(opts.output, "out.html", "output");
    expectEq(parse_args(["in.md", "--output=x.html"]).unwrap().output, "x.html", "--output=");
}

func test_page_options(): void {
    expect(parse_args(["-s"]).unwrap().standalone, "-s");
    let titled = parse_args(["--title", "Notes"]).unwrap();
    expect(titled.standalone and titled.title_given, "--title implies -s");
    expectEq(titled.title, "Notes", "title");
    let page = parse_args(["--template=page.html"]).unwrap();
    expect(page.standalone, "--template implies -s");
    expectEq(page.page_file, "page.html", "template file");
    expect(parse_args(["--title="]).unwrap().title_given, "an empty title is still given");
}

func test_dash_and_double_dash(): void {
    expectEq(parse_args(["-"]).unwrap().input, "-", "- is stdin");
    expectEq(parse_args(["--", "-odd.md"]).unwrap().input, "-odd.md", "after --");
}

func test_errors(): void {
    expectEq(parse_args(["a.md", "b.md"]).unwrap_err(), "extra operand 'b.md'", "two files");
    expectEq(parse_args(["-x"]).unwrap_err(), "unknown option '-x'", "unknown");
    expectEq(parse_args(["-o"]).unwrap_err(), "option '-o' requires a value", "missing value");
    expectEq(parse_args(["--standalone=yes"]).unwrap_err(), "option '--standalone' does not take a value", "flag value");
}

func test_help_and_version(): void {
    expect(parse_args(["--help"]).unwrap().help, "--help");
    expect(parse_args(["-h"]).unwrap().help, "-h");
    expect(parse_args(["--version"]).unwrap().version, "--version");
    expect(parse_args(["-V"]).unwrap().version, "-V");
}
