@mode(host.dual)

# Character classes and small string helpers shared by both passes.

const PUNCTUATION: string = "!\"#$%&'()*+,-./:;<=>?@[\\]^_`{|}~";
const DIGITS: string = "0123456789";
const LETTERS: string = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ";

pub func is_digit(ch: string): bool {
    return ch.len() == 1 and DIGITS.index_of(ch) >= 0;
}

pub func is_letter(ch: string): bool {
    return ch.len() == 1 and LETTERS.index_of(ch) >= 0;
}

# ASCII punctuation, the characters a backslash can escape.
pub func is_punctuation(ch: string): bool {
    return ch.len() == 1 and PUNCTUATION.index_of(ch) >= 0;
}

# Whitespace for the flanking rules; "" (the edge of the text) counts too.
pub func is_space(ch: string): bool {
    return ch == "" or ch == " " or ch == "\t" or ch == "\n" or ch == "\r";
}

pub func chars_of(text: string): list[string] {
    var chars: list[string] = [];
    for (ch in text) {
        chars.push(ch);
    }
    return chars;
}

# Escapes text for HTML content and attribute values.
pub func escape_html(text: string): string {
    if (text.index_of("&") < 0 and text.index_of("<") < 0 and text.index_of(">") < 0 and text.index_of("\"") < 0) {
        return text;
    }
    var parts: list[string] = [];
    for (ch in text) {
        if (ch == "&") {
            parts.push("&amp;");
        } else if (ch == "<") {
            parts.push("&lt;");
        } else if (ch == ">") {
            parts.push("&gt;");
        } else if (ch == "\"") {
            parts.push("&quot;");
        } else {
            parts.push(ch);
        }
    }
    return parts.join("");
}

# Number of leading spaces, with a tab advancing to the next multiple of 4.
pub func indent_of(line: string): int {
    var width = 0;
    for (ch in line) {
        if (ch == " ") {
            width += 1;
        } else if (ch == "\t") {
            width = width + 4 - width % 4;
        } else {
            return width;
        }
    }
    return width;
}

# The line with its leading tabs expanded to spaces (tab stops of 4).
pub func expand_leading_tabs(line: string): string {
    if (line.index_of("\t") < 0) {
        return line;
    }
    var width = 0;
    var i = 0;
    let chars = chars_of(line);
    while (i < chars.len() and (chars[i] == " " or chars[i] == "\t")) {
        if (chars[i] == " ") {
            width += 1;
        } else {
            width = width + 4 - width % 4;
        }
        i += 1;
    }
    return " ".repeat(width) + chars.slice(i).join("");
}

# Removes n columns of leading whitespace (fewer if the line has less). A
# tab counts up to the next multiple of 4; a tab that is only partly
# removed leaves the rest of its width as spaces. Later tabs are kept.
pub func remove_columns(line: string, n: int): string {
    var col = 0;
    var i = 0;
    let chars = chars_of(line);
    while (i < chars.len() and col < n) {
        if (chars[i] == " ") {
            col += 1;
        } else if (chars[i] == "\t") {
            let next = col + 4 - col % 4;
            if (next > n) {
                return " ".repeat(next - n) + chars.slice(i + 1).join("");
            }
            col = next;
        } else {
            break;
        }
        i += 1;
    }
    return chars.slice(i).join("");
}

# Removes up to n leading spaces.
pub func strip_indent(line: string, n: int): string {
    var i = 0;
    while (i < n and i < line.len() and line.slice(i, i + 1) == " ") {
        i += 1;
    }
    return line.slice(i);
}

pub func is_blank(line: string): bool {
    return line.trim().len() == 0;
}

pub func trim_end_spaces(text: string): string {
    var end = text.len();
    while (end > 0 and (text.slice(end - 1, end) == " " or text.slice(end - 1, end) == "\t")) {
        end -= 1;
    }
    return text.slice(0, end);
}

pub func trim_start_spaces(text: string): string {
    var start = 0;
    while (start < text.len() and (text.slice(start, start + 1) == " " or text.slice(start, start + 1) == "\t")) {
        start += 1;
    }
    return text.slice(start);
}

# A link label normalised for matching: lower case, inner whitespace
# collapsed to one space, trimmed.
pub func normalize_label(label: string): string {
    var parts: list[string] = [];
    for (word in label.toLowerCase().split(" ")) {
        for (piece in word.split("\n")) {
            let p = piece.trim();
            if (p.len() > 0) {
                parts.push(p);
            }
        }
    }
    return parts.join(" ");
}

# The text of some HTML with its tags removed; an image counts as its alt
# text. Entities stay escaped, so the result is still HTML.
pub func strip_tags(html: string): string {
    if (html.index_of("<") < 0) {
        return html;
    }
    var parts: list[string] = [];
    var tag: list[string] = [];
    var in_tag = false;
    for (ch in html) {
        if (ch == "<" and !in_tag) {
            in_tag = true;
            tag = [];
        } else if (ch == ">" and in_tag) {
            in_tag = false;
            let t = tag.join("");
            if (t.startsWith("img ")) {
                let a = t.index_of("alt=\"");
                if (a >= 0) {
                    let rest = t.slice(a + 5);
                    parts.push(rest.slice(0, rest.index_of("\"")));
                }
            }
        } else if (in_tag) {
            tag.push(ch);
        } else {
            parts.push(ch);
        }
    }
    return parts.join("");
}

# Percent-encodes the characters that may not appear in an href as is
# (spaces, and the few ASCII characters browsers reject); everything else,
# including existing %XX escapes, is kept.
pub func encode_url(url: string): string {
    var parts: list[string] = [];
    for (ch in url) {
        if (ch == " ") {
            parts.push("%20");
        } else if (ch == "\\") {
            parts.push("%5C");
        } else if (ch == "`") {
            parts.push("%60");
        } else if (ch == "{") {
            parts.push("%7B");
        } else if (ch == "}") {
            parts.push("%7D");
        } else if (ch == "|") {
            parts.push("%7C");
        } else if (ch == "^") {
            parts.push("%5E");
        } else if (ch == "\"") {
            parts.push("%22");
        } else if (ch == "<") {
            parts.push("%3C");
        } else if (ch == ">") {
            parts.push("%3E");
        } else {
            parts.push(ch);
        }
    }
    return parts.join("");
}
