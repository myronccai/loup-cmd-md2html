@mode(host.dual)

# Command-line parsing for md2html:
#
#   md2html [OPTION]... [FILE]
#
# Options may appear anywhere before `--`. Value options accept `-x VALUE`,
# `--name VALUE` and `--name=VALUE`. FILE `-` (or none) is standard input.

pub struct Options {
    pub help: bool;
    pub version: bool;
    pub input: string;
    pub output: string;
    pub standalone: bool;
    pub page_file: string;
    pub title: string;
    pub title_given: bool;
}

pub func parse_args(argv: list[string]): Result[Options, string] {
    var help = false;
    var version = false;
    var operands: list[string] = [];
    var output = "";
    var standalone = false;
    var page_file = "";
    var title = "";
    var title_given = false;
    var only_operands = false;

    var i = 0;
    while (i < argv.len()) {
        let arg = argv[i];
        i += 1;
        if (only_operands or arg == "-" or !arg.startsWith("-")) {
            operands.push(arg);
            continue;
        }
        if (arg == "--") {
            only_operands = true;
            continue;
        }

        var name = arg;
        var value = "";
        var has_value = false;
        if (arg.startsWith("--") and arg.contains("=")) {
            let at = arg.index_of("=");
            name = arg.slice(0, at);
            value = arg.slice(at + 1);
            has_value = true;
        }

        if (name == "-h" or name == "--help" or name == "-V" or name == "--version" or name == "-s" or name == "--standalone") {
            if (has_value) {
                return Err("option '" + name + "' does not take a value");
            }
            if (name == "-h" or name == "--help") {
                help = true;
            } else if (name == "-V" or name == "--version") {
                version = true;
            } else {
                standalone = true;
            }
            continue;
        }

        let takes_value = name == "-o" or name == "--output" or name == "-t" or name == "--template" or name == "--title";
        if (!takes_value) {
            return Err("unknown option '" + name + "'");
        }
        if (!has_value) {
            if (i >= argv.len()) {
                return Err("option '" + name + "' requires a value");
            }
            value = argv[i];
            i += 1;
        }
        if (name == "-o" or name == "--output") {
            output = value;
        } else if (name == "--title") {
            title = value;
            title_given = true;
            standalone = true;
        } else {
            page_file = value;
            standalone = true;
        }
    }

    if (operands.len() > 1) {
        return Err("extra operand '" + operands[1] + "'");
    }
    var input = "-";
    if (operands.len() == 1) {
        input = operands[0];
    }
    return Ok(Options(
        help = help,
        version = version,
        input = input,
        output = output,
        standalone = standalone,
        page_file = page_file,
        title = title,
        title_given = title_given,
    ));
}
