@mode(host.dual)

# md2html: the command line from start to finish: parse the arguments,
# answer --help and --version, convert, and map failures to exit statuses
# (2 for a usage error, 1 for an exception).
#
# Runtime: host.dual. Compiled into the native binary build/md2html by `make
# build`; `loup run source/main.loup` interprets the same code. Unit tests
# call run() directly with an argument list.

from appinfo import (APP_NAME, EXIT_OK, EXIT_FAILURE, EXIT_USAGE);
from cli.args import (parse_args);
from cli.usage import (usage, version_line);
from commands.md2html import (run_md2html);

# Parses argv, converts and returns the exit status.
pub func run(argv: list[string]): int {
    let parsed = parse_args(argv);
    if (parsed.is_err()) {
        printErr(APP_NAME + ": " + parsed.unwrap_err());
        printErr("Try '" + APP_NAME + " --help' for more information.");
        return EXIT_USAGE;
    }
    let opts = parsed.unwrap();

    if (opts.help) {
        println(usage());
        return EXIT_OK;
    }
    if (opts.version) {
        println(version_line());
        return EXIT_OK;
    }

    try {
        return run_md2html(opts);
    } catch (Exception as e) {
        printErr(APP_NAME + ": " + e.message);
        return EXIT_FAILURE;
    }
}
