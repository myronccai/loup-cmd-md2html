@mode(host.dual)

# md2html: the --help text and the --version line.
#
# Runtime: host.dual. Compiled into the native binary build/md2html by `make
# build`; `loup run source/main.loup` interprets the same code.

from appinfo import (APP_NAME, APP_VERSION);

pub func usage(): string {
    let lines = [
        "usage: " + APP_NAME + " [OPTION]... [FILE]",
        "",
        "Convert Markdown to HTML. With no FILE, or when FILE is -, read standard",
        "input. The HTML goes to standard output unless -o is given.",
        "",
        "  -o, --output FILE    write the HTML to FILE",
        "  -s, --standalone     write a whole HTML page, not just the body",
        "  -t, --template FILE  write a page using FILE, in which {{title}} and",
        "                       {{body}} are replaced (implies -s)",
        "      --title TEXT     the page title (implies -s); by default the first",
        "                       heading, else the file name",
        "  -h, --help           display this help and exit",
        "  -V, --version        output version information and exit",
        "",
        "Markdown: ATX and setext headings, paragraphs, emphasis, code spans,",
        "fenced and indented code, block quotes, lists, links, images, reference",
        "links, autolinks, thematic breaks, hard line breaks and tables. Raw HTML",
        "is escaped.",
        "",
        "Exit status: 0 on success, 1 if a file cannot be read or written, 2 on",
        "a usage error.",
    ];
    return lines.join("\n");
}

pub func version_line(): string {
    return APP_NAME + " (loup-cmd-" + APP_NAME + ") " + APP_VERSION;
}
