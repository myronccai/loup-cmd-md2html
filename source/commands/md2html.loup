@mode(host.dual)

# md2html: read the input, convert it, optionally wrap it in a page, and
# write it out.
#
# Runtime: host.dual. Compiled into the native binary build/md2html by `make
# build`; `loup run source/main.loup` interprets the same code, and `make
# parity` requires the same HTML from both lanes for tests/fixtures/*.md.
# Everything but run_md2html is a pure function returning text, so the unit
# tests check output without capturing stdout.

from appinfo import (APP_NAME, EXIT_OK, EXIT_FAILURE);
from cli.args import (Options);
from io.fs import (isDir);
from io.path import (basename, dirname);
from markdown.text import (escape_html);
from markdown.render import (markdown_to_html, first_heading);

## The page that -s writes when no -t template is given.
##
## A function rather than a const: a """ string is not a constant
## expression for `loup run` and native builds. The text of a """ string
## starts after the opening line and loses the indentation of the closing
## """, and its last line has no newline, so the final one is added.
pub func default_template(): string {
    let page = """
    <!DOCTYPE html>
    <html>
    <head>
    <meta charset="utf-8">
    <title>{{title}}</title>
    </head>
    <body>
    {{body}}</body>
    </html>
    """;
    return page + "\n";
}

## The page title: --title, else the first heading, else the file name
## without its extension, else "Untitled".
pub func page_title(opts: Options, source: string): string {
    if (opts.title_given) {
        return escape_html(opts.title);
    }
    let heading = first_heading(source);
    if (heading.len() > 0) {
        return heading;
    }
    if (opts.input != "-") {
        var name = basename(opts.input);
        let dot = name.index_of(".");
        if (dot > 0) {
            name = name.slice(0, dot);
        }
        return escape_html(name);
    }
    return "Untitled";
}

## Fills {{title}} and {{body}} in a page template.
pub func fill_template(layout: string, title: string, body: string): string {
    # Split on {{body}} first so that a {{title}} inside the body text is
    # left alone. `parts` needs its type: natively, a comprehension over an
    # unannotated `let` holding a split() result crashes.
    let parts: list[string] = layout.split("{{body}}");
    let filled: list[string] = [part.replace("{{title}}", title) for part in parts];
    return filled.join(body);
}

## The complete output for a source text: the HTML fragment, or with -s
## the page `layout` filled with it.
pub func convert(opts: Options, source: string, layout: string): string {
    let body = markdown_to_html(source);
    if (!opts.standalone) {
        return body;
    }
    return fill_template(layout, page_title(opts, source), body);
}

# Why a file cannot be read ("" when it can). Checked before reading: the
# IoError that readText throws cannot be caught in a native build or under
# the self-hosted `loup run` (the program would stop with the runtime's own
# message), so the usual causes get md2html's message and status 1 here.
func read_problem(path: string): string {
    if (!exists(path)) {
        return path + ": No such file or directory";
    }
    if (isDir(path)) {
        return path + ": Is a directory";
    }
    return "";
}

pub func run_md2html(opts: Options): int {
    var source = "";
    if (opts.input == "-") {
        source = readText("/dev/stdin");
    } else {
        let problem = read_problem(opts.input);
        if (problem.len() > 0) {
            printErr(APP_NAME + ": " + problem);
            return EXIT_FAILURE;
        }
        source = readText(opts.input);
    }

    var layout = default_template();
    if (opts.page_file.len() > 0) {
        let problem = read_problem(opts.page_file);
        if (problem.len() > 0) {
            printErr(APP_NAME + ": " + problem);
            return EXIT_FAILURE;
        }
        layout = readText(opts.page_file);
    }

    let html = convert(opts, source, layout);
    if (opts.output.len() == 0) {
        print(html);
        return EXIT_OK;
    }
    # The same for -o: a failed writeText cannot be caught either, so the
    # output's directory is checked first.
    var dir = dirname(opts.output);
    if (dir.len() == 0) {
        dir = ".";
    }
    if (!isDir(dir)) {
        printErr(APP_NAME + ": " + opts.output + ": No such file or directory");
        return EXIT_FAILURE;
    }
    if (isDir(opts.output)) {
        printErr(APP_NAME + ": " + opts.output + ": Is a directory");
        return EXIT_FAILURE;
    }
    writeText(opts.output, html);
    return EXIT_OK;
}
