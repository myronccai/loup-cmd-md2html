@mode(host.dual)

# md2html: application identity and exit statuses. Keep APP_NAME and
# APP_VERSION in step with `name` and `version` in package.lppkg.
#
# Runtime: host.dual. Compiled into the native binary build/md2html by `make
# build`; `loup run source/main.loup` interprets the same code.

pub const APP_NAME: string = "md2html";
pub const APP_VERSION: string = "0.1.0";
pub const APP_SUMMARY: string = "Convert Markdown (a CommonMark subset with tables) to HTML.";

# Exit statuses returned by main().
pub const EXIT_OK: int = 0;
pub const EXIT_FAILURE: int = 1;
pub const EXIT_USAGE: int = 2;
